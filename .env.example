# Optional Free Financial API Keys for HDFC Predictor
# Note: The system runs 100% free out-of-the-box using yfinance and Google News RSS feeds.
# Adding keys below unlocks additional cross-market validation and deeper sentiment metrics.

# 1. Finnhub (Free tier: 60 API calls/min - Get free key at https://finnhub.io)
FINNHUB_API_KEY=

# 2. Alpha Vantage (Free tier: 25 requests/day - Get free key at https://www.alphavantage.co)
ALPHAVANTAGE_API_KEY=

# 3. NewsAPI (Optional news aggregator - Get free key at https://newsapi.org)
NEWS_API_KEY=
